# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
# Domain astrevix.com must be verified in Resend.
# Emails are sent from contact@astrevix.com.
RESEND_API_KEY=

# Stripe (subscriptions)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate limiting (Upstash Redis REST). Optional — falls back to an in-memory
# limiter when unset. Create a database at console.upstash.com and copy the
# REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bot protection (Cloudflare Turnstile). Optional — the captcha is inert until
# BOTH keys are set. Create a site at dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
